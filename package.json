  "scripts": {
    "nx": "nx",
    "start:admin": "nx serve admin --port=4200",
    "start:client": "nx serve client --port=4201",
    "start:dev": "concurrently \"npm:serve:admin\" \"npm:serve:client\"",
    "serve:admin": "nx serve admin --port=4200 --hmr=false",
    "serve:client": "nx serve client --port=4201 --hmr=false",
    "build:admin": "nx build admin --configuration=production",
    "build:client": "nx build client --configuration=production",
    "build:all": "nx run-many --target=build --all",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "affected": "nx affected -t lint test build",
    "affected:build": "nx affected -t build",
    "affected:lint": "nx affected -t lint",
    "affected:test": "nx affected -t test",
    "affected:graph": "nx affected --graph"
