{
  "name": "admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "em",
  "sourceRoot": "apps/admin/src",
  "tags": ["scope:admin", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser-esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/admin",
        "index": "apps/admin/src/index.html",
        "main": "apps/admin/src/main.ts",
        "polyfills": "apps/admin/src/polyfills.ts",
        "tsConfig": "apps/admin/tsconfig.app.json",
        "stylePreprocessorOptions": {
          "includePaths": ["apps/admin/src/app", "libs/shared/styles", "node_modules"]
        },
        "assets": [
          "apps/admin/src/favicon.ico",
          "apps/admin/src/assets",
          {
            "glob": "**/*",
            "input": "apps/admin/src/assets",
            "output": "/assets"
          },
          {
            "glob": "**/*",
            "input": "libs/shared/assets",
            "output": "/assets"
          }
        ],
        "allowedCommonJsDependencies": [
          "qrcode",
          "apexcharts",
          "file-saver",
          "pdfjs-dist/build/pdf",
          "pdfjs-dist/web/pdf_viewer",
          "js-sha256",
          "print-js",
          "leaflet",
          "moment"
        ],
        "styles": [
          { "input": "apps/admin/src/styles.scss", "inject": false },
          { "input": "apps/admin/src/late-styles.scss", "inject": false },
          { "input": "node_modules/driver.js/dist/driver.css", "inject": false }
        ],
        "scripts": ["node_modules/apexcharts/dist/apexcharts.min.js"],
        "serviceWorker": true,
        "ngswConfigPath": "apps/admin/ngsw-config.json",
        "outputHashing": "all"
      },
      "configurations": {
        "test": {
          "fileReplacements": [
            {
              "replace": "apps/admin/src/environments/environment.ts",
              "with": "apps/admin/src/environments/environment.testing.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "bundles",
          "sourceMap": true,
          "namedChunks": true,
          "extractLicenses": true,
          "buildOptimizer": false,
          "budgets": [
            { "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" },
            { "type": "anyComponentStyle", "maximumWarning": "60kb", "maximumError": "100kb" }
          ]
        },
        "pre-prod": {
          "fileReplacements": [
            {
              "replace": "apps/admin/src/environments/environment.ts",
              "with": "apps/admin/src/environments/environment.pre-prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "bundles",
          "sourceMap": true,
          "namedChunks": true,
          "extractLicenses": true,
          "buildOptimizer": true,
          "budgets": [
            { "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" },
            { "type": "anyComponentStyle", "maximumWarning": "60kb", "maximumError": "100kb" }
          ]
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/admin/src/environments/environment.ts",
              "with": "apps/admin/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "bundles",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "buildOptimizer": true,
          "budgets": [
            { "type": "initial", "maximumWarning": "2mb", "maximumError": "5mb" },
            { "type": "anyComponentStyle", "maximumWarning": "60kb", "maximumError": "100kb" }
          ]
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": false
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "admin:build:production"
        },
        "development": {
          "buildTarget": "admin:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "admin:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/admin/jest.config.ts",
        "tsConfig": "apps/admin/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "admin:build",
        "staticFilePath": "dist/apps/admin",
        "spa": true
      }
    }
  }
}
